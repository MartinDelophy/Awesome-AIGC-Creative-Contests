{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MartinDelophy/Awesome-AIGC-Creative-Contests/blob/main/data/opportunities/manifest.schema.json",
  "title": "Optional opportunity dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "updated_on", "default_core_path", "datasets"],
  "properties": {
    "$schema": { "const": "./manifest.schema.json" },
    "version": { "const": 1 },
    "updated_on": { "type": "string", "format": "date" },
    "default_core_path": { "const": "../contests.json" },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "label",
          "description",
          "region_codes",
          "record_count",
          "default_included"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "path": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.json$" },
          "label": {
            "type": "object",
            "additionalProperties": false,
            "required": ["zh", "en"],
            "properties": {
              "zh": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            }
          },
          "description": {
            "type": "object",
            "additionalProperties": false,
            "required": ["zh", "en"],
            "properties": {
              "zh": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            }
          },
          "region_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 2 }
          },
          "record_count": { "type": "integer", "minimum": 0 },
          "default_included": { "const": false }
        }
      }
    }
  }
}
